#!/usr/bin/env python3
"""hyprutil launcher for running straight from a checkout.

The installed copy at <prefix>/bin/hyprutil is generated from
system/bin/hyprutil.in instead, and points at the installed package rather
than at this repo -- see setup.sh.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from hyprutil.cli import main

if __name__ == "__main__":
    main()
