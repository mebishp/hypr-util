#!/usr/bin/env python3
"""hyprutil launcher -- see hyprutil/cli.py for the actual implementation.

Generated from system/bin/hyprutil.in by setup.sh, which substitutes the
install prefix below. The repo's own bin/hyprutil is the equivalent
run-from-checkout launcher, for working on the code without installing.
"""
import sys

sys.path.insert(0, "@LIBDIR@")

from hyprutil.cli import main

if __name__ == "__main__":
    main()
